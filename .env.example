TELEGRAM_BOT_TOKEN=TELEGRAM_BOT_TOKEN
ISSUE_LINK=ISSUE_LINK

MINI_APP_FORMS_ENABLED=true
MINI_APP_FORMS_LAUNCH_URL=MINI_APP_FORMS_LAUNCH_URL
MINI_APP_FORMS_STREAM_URL=MINI_APP_FORMS_STREAM_URL
MINI_APP_FORMS_WEBHOOK_SECRET=MINI_APP_FORMS_WEBHOOK_SECRET
MINI_APP_FORMS_TRANSPORT=poll
MINI_APP_FORMS_POLL_INTERVAL_SECONDS=3

# Optional overrides for form field UUIDs:
MINI_APP_FORMS_BIRTH_DATE_FIELD_ID=MINI_APP_FORMS_BIRTH_DATE_FIELD_ID
MINI_APP_FORMS_GENDER_FIELD_ID=MINI_APP_FORMS_GENDER_FIELD_ID
MINI_APP_FORMS_AREA_CODE_FIELD_ID=MINI_APP_FORMS_AREA_CODE_FIELD_ID
MINI_APP_FORMS_SERIAL_NUMBER_FIELD_ID=MINI_APP_FORMS_SERIAL_NUMBER_FIELD_ID

VPN_TOKEN=VPN_TOKEN

# VPN selection filters (substring match, case-insensitive)
VPN_EXCLUDE_KEYWORDS=россия,whitelist

# Local v2ray SOCKS listener used by health checker
VPN_SOCKS_PROXY_URL=socks5h://127.0.0.1:1080

# Faster per-location Telegram probe during VPN location scan
VPN_LOCATION_PROBE_TIMEOUT=3.5
VPN_LOCATION_PROBE_STARTUP_SECONDS=2.5
